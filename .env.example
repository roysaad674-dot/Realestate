# Copy to .env and adjust. .env is git-ignored.

APP_NAME=EstateOS
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost:8787
APP_TIMEZONE=Asia/Kolkata

# XAMPP defaults (MariaDB, root with no password)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=estateos
DB_USERNAME=root
DB_PASSWORD=

# Seconds of inactivity before the session expires, and its hard ceiling
SESSION_LIFETIME=7200
SESSION_ABSOLUTE=43200

MAX_LOGIN_ATTEMPTS=6
LOCKOUT_MINUTES=15

# Outbound mail. 'log' records the message and writes it to storage/logs/mail.log
# without sending anything; 'mail' uses PHP's mail(); 'smtp' talks to a server.
MAIL_DRIVER=log
MAIL_FROM=no-reply@estateos.test
MAIL_FROM_NAME=EstateOS
MAIL_REPLY_TO=
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_MAX_ATTEMPTS=3

# Outbound WhatsApp. 'none' transmits nothing and leaves messages queued;
# 'log' writes them to storage/logs/whatsapp.log; 'cloud' posts to the Meta
# WhatsApp Cloud API, which needs both the token and the phone number id.
# Note that free-form text only reaches a customer inside the 24-hour window
# their own last message opens — outside it Meta requires an approved template.
WHATSAPP_DRIVER=none
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TIMEOUT=15
WHATSAPP_MAX_ATTEMPTS=3

# Customer portal
PORTAL_ENABLED=true
PORTAL_MAX_ATTEMPTS=6
PORTAL_LOCKOUT_MINUTES=15
